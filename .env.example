# Copie para .env. Nunca inclua chaves no frontend, vault, logs ou conversa.
# Chave não vazia neste arquivo tem precedência sobre a variável herdada.
OPENAI_API_KEY=
GEMINI_API_KEY=
FISH_API_KEY=
# GOOGLE_API_KEY é um alias aceito quando GEMINI_API_KEY não estiver definido.

HOST=127.0.0.1
PORT=8000

# IDs obtidos na lista Modelo de Configurações (não há modelo presumido).
JARVIS_PROVIDER=openai-api
JARVIS_MODEL=
JARVIS_FALLBACK_PROVIDER=
JARVIS_FALLBACK_MODEL=
# Escolhas feitas no painel persistem em .data/settings.json e vencem estes defaults.

# Dados e Hermes são isolados; defaults relativos à pasta do projeto.
# JARVIS_DATA_DIR=C:/caminho/dados
# JARVIS_HERMES_HOME=C:/caminho/dados/hermes
# HERMES_SOURCE=C:/caminho/hermes-agent
# HERMES_PYTHON= (opcional; use o runtime preparado por scripts/setup.ps1)
OBSIDIAN_VAULT_PATH=C:/Users/PC Gamer/Documents/JARVIS-Memory
# Separe diretórios autorizados com ;. Default: pasta workspace deste projeto.
# JARVIS_WORKSPACE_ROOTS=C:/projetos/autorizados;C:/documentos/autorizados

# Voz: escolha explícita, sem fallback oculto entre fornecedores.
# fish-audio: voz Jarvis (UCM) escolhida, online; exige FISH_API_KEY.
# qwen-local: referência JARVIS recriada localmente, CPU apenas, sem API de voz.
# piper: voz neural Faber local; offline: SAPI Windows; edge: Microsoft online.
# openai: usa a chave OpenAI e exige modelo de áudio abaixo.
JARVIS_TTS_PROVIDER=piper
# Motor Fish explícito; sem fallback automático para motor pago/outra voz.
FISH_TTS_MODEL=s2.1-pro-free
JARVIS_QWEN_THREADS=8
# Voz neural: prepare os arquivos com scripts/setup_voice.ps1.
# JARVIS_PIPER_MODEL=C:/caminho/pt_BR-faber-medium.onnx
JARVIS_PIPER_LENGTH_SCALE=1.18
JARVIS_TTS_VOICE=pt-BR-AntonioNeural
JARVIS_TTS_RATE=-4%
JARVIS_TTS_PITCH=-2Hz
# STT: whisper-local (padrão, prepare com scripts/setup_voice.ps1), google-web ou openai.
JARVIS_STT_PROVIDER=whisper-local
# JARVIS_WHISPER_PATH=C:/caminho/whisper-base
# Opcionais: nome do dispositivo PortAudio; sem valor usa o padrão do Windows.
JARVIS_INPUT_DEVICE=
JARVIS_OUTPUT_DEVICE=
JARVIS_VAD_THRESHOLD=0.004
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=onyx
OPENAI_STT_MODEL=

# Orçamentos conservadores; reinicie após alterar.
JARVIS_MAX_STEPS=6
JARVIS_MAX_OUTPUT_TOKENS=1500
JARVIS_MAX_CONTEXT_CHARS=24000
JARVIS_TASK_TIMEOUT=120
JARVIS_MAX_DAILY_TASKS=30
JARVIS_MAX_DAILY_TOKENS=100000
# Limite diário de tokens na admissão: uma tarefa em curso pode ultrapassá-lo.
# Preços estimativos: .data/settings.json, input_price_per_million,
# output_price_per_million, prices_updated (YYYY-MM-DD). Não são cobrança exata.
